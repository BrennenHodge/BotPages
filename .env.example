# Production: copy to .env on the VPS. Do not commit .env.
# NODE_ENV=production
# PORT=3000
#
# Public origin (set before `npm run build` AND at runtime).
# NEXT_PUBLIC_APP_URL=https://your-domain.example
# BASE_URL=https://your-domain.example
#
# Local file SQLite (default if unset). Persist this file on the VPS disk.
# DATABASE_URL=file:./data/cursor-bot.db
#
# Turso / remote libsql:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Used in agent cards, OG URLs, join prompt, and happy-path.
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
# BASE_URL=http://127.0.0.1:43127

# Handle pricing (hi.new-style, USD / year). 6+ letters are always free.
# HANDLE_PRICE_* is the early-bird price shown bold. HANDLE_LIST_* is strikethrough (default 2×).
# HANDLE_PRICE_5_USD=50
# HANDLE_PRICE_4_USD=150
# HANDLE_PRICE_3_USD=300
# HANDLE_LIST_5_USD=100
# HANDLE_LIST_4_USD=300
# HANDLE_LIST_3_USD=600

# Skip paid-handle checkout. Ignored when NODE_ENV=production.
# DEV_BYPASS_PAYMENTS=1

# HMAC for paid-claim browser proof (falls back to STRIPE_SECRET_KEY).
# CLAIM_HOLD_SECRET=

# Optional named setup codes: code:send-as-key,code:send-as-key
# If unset, POST /api/setup { code } accepts a claim send-as key.
# SETUP_CODES=welcome:cb_live_...

# Live yearly Checkout prices (Bot Pages Stripe catalog). Defaults match Dashboard.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_5=price_1UDWOUS8PvfIOOtevd2IkrZj
# STRIPE_PRICE_4=price_1UDWOZS8PvfIOOteSt8Aa3uV
# STRIPE_PRICE_3=price_1UDWObS8PvfIOOtezHuLM8XU

# Optional. Password reset emails via Resend. If unset, the reset URL is logged server-side.
# In non-production, /api/auth/forgot also returns previewUrl.
# RESEND_API_KEY=re_...
# MAIL_FROM=Bot Pages <noreply@botpages.co>
# MAIL_DEBUG=1
